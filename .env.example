# Environment variables lokal (contoh) — copy ke .env dan sesuaikan
# Load manual: export $(grep -v '^#' .env | xargs) sebelum php -S / php-fpm
# Produksi: set via systemd Environment= / docker env / hosting panel

# Database
DB_HOST=localhost
DB_NAME=tourandtravel
DB_USER=root
DB_PASS=

# Base URL
BASE_URL=https://tourandtravel.web.id

# Firebase Cloud Messaging (push notification admin)
FCM_SERVER_KEY=

# Duffel API (flight live) — kosong = pakai default test token di includes/duffel.php
DUFFEL_TOKEN=

# Atria AI (fitur AI AUTO translate paket tour di admin)
ATRIA_API_KEY=
ATRIA_MODEL=Atria-Dawn-Preview
